   "rdfs:isDefinedBy": {
    "@id": "https://data.energystoragera.org/ns"
   },
   "rdfs:label": {
    "@language": "en",
    "@value": "Alert"
   },
   "skos:definition": {
    "@language": "en",
    "@value": "A rule's finding about the graph, open until an action closes it."
   },
   "skos:editorialNote": {
    "@language": "en",
    "@value": "No alert or finding class exists in the bundled ontology or schema.org."
   }
  },
  {
