    "@type": "xsd:date",
    "@value": "2026-11-13"
   },
   "dcterms:source": "Data_pipeline/ontology/vocabulary/ontology.yaml",
   "rdfs:isDefinedBy": {
    "@id": "https://data.energystoragera.org/ns"
   },
   "rdfs:label": {
    "@language": "en",
    "@value": "Action"
   },
   "skos:altLabel": {
    "@language": "en",
    "@value": "ActionRecord"
   },
   "skos:definition": {
    "@language": "en",
    "@value": "One recorded change a person or an agent made to the graph, undoable."
   },
   "skos:editorialNote": {
    "@language": "en",
    "@value": "schema:Action names the act, not the appended record of it; decided in the actions phase."
   }
  },
  {
   "@id": "esra:Alert",
