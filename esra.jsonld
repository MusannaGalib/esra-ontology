  {
   "@id": "https://data.energystoragera.org/ns",
   "@type": "owl:Ontology",
   "dcterms:creator": "ESRA platform",
   "dcterms:date": {
    "@type": "xsd:date",
    "@value": "2026-11-15"
   },
   "dcterms:description": {
    "@language": "en",
    "@value": "The terms the Energy Storage Research Alliance data platform adds on top of EMMO and BattINFO: how a deposited battery study is put together (study, cell, sample, batch, file, instrument) and where every recorded value came from (read from a file, stated by the author, computed, answered by a person, or extracted by an AI and not yet reviewed). Measured quantities themselves are named with EMMO, BattINFO, CHAMEO and QUDT terms; an ESRA term exists only where those have none."
   },
   "dcterms:license": {
    "@id": "https://creativecommons.org/licenses/by/4.0/"
   },
   "dcterms:publisher": "Energy Storage Research Alliance, Argonne National Laboratory",
   "dcterms:source": [
    "Data_pipeline/ontology/vocabulary/annotations.yaml",
    "Data_pipeline/ontology/vocabulary/derived.yaml",
    "Data_pipeline/ontology/vocabulary/graph_terms.yaml",
    "Data_pipeline/ontology/vocabulary/ontology.yaml",
    "Data_pipeline/ontology/vocabulary/semantic.yaml"
   ],
   "dcterms:title": {
    "@language": "en",
    "@value": "ESRA ontology"
   },
   "owl:versionIRI": {
    "@id": "https://data.energystoragera.org/ns/2026-11-17"
   },
   "owl:versionInfo": "2026-11-17",
   "rdfs:comment": {
    "@language": "en",
    "@value": "The terms of the ESRA namespace: the classes, properties and links of the working graph, the vocabulary of the semantic layer and the terms a person approved. Generated by Data_pipeline/ontology/build_esra_ttl.py."
   },
   "rdfs:label": {
    "@language": "en",
    "@value": "ESRA ontology"
   },
   "rdfs:seeAlso": [
    {
     "@id": "https://github.com/MusannaGalib/esra-ontology"
    },
