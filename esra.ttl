    dcterms:creator "ESRA platform" ;
    dcterms:source "Data_pipeline/ontology/vocabulary/graph_terms.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "A readable address of where the value sits, such as file, sheet and row; on a column, its cell range."@en ;
    skos:notation "locatorText" ;
    schema:domainIncludes esra:Column,
        esra:Locator .

esra:mass_mg a owl:DatatypeProperty ;
    rdfs:label "mass (mg)"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-15"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/annotations.yaml",
        "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    qudt:hasUnit unit:MilliGM ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "The mass of a cell's pellet or electrode, of a sample or of a batch, in milligrams."@en ;
    skos:notation "mass_mg" ;
    schema:domainIncludes esra:Batch,
        esra:Cell,
        esra:Sample ;
    schema:propertyID emmo:EMMO_ed4af7ae_63a2_497e_bb88_2309619ea405 ;
    schema:unitText "mg" .

esra:match a rdf:Property ;
    rdfs:label "match"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:source "Data_pipeline/ontology/vocabulary/graph_terms.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "The key values by which a source row was matched to the cell, such as a column value or a saved answer."@en .

esra:matchLevels a rdf:Property ;
