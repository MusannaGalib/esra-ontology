    skos:definition "Read from a spreadsheet or table the authors deposited."@en ;
    skos:inScheme esra:OriginValues ;
    skos:notation "author_sheet" ;
    skos:scopeNote "Evidence class deposit_evidence: Read or taken from what the authors deposited."@en .

<https://data.energystoragera.org/ns#origin/derived> a skos:Concept ;
