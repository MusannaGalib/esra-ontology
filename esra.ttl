    skos:definition "Extracted by an AI and not reviewed."@en ;
    skos:inScheme esra:OriginValues ;
    skos:notation "ai_extracted_unreviewed" ;
    skos:scopeNote "Evidence class not_deposit_evidence: Not read from the deposit."@en .

<https://data.energystoragera.org/ns#origin/author_result> a skos:Concept ;
    rdfs:label "author result"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/semantic.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "Computed or picked by the authors with their own software or in their own sheet (a result column kept as they computed it, or a fit or peak-pick report they saved as a text or XML file). A result, not an input; the ESRA scan did not compute it."@en ;
    skos:inScheme esra:OriginValues ;
    skos:notation "author_result" ;
    skos:scopeNote "Evidence class deposit_evidence: Read or taken from what the authors deposited."@en .

<https://data.energystoragera.org/ns#origin/author_sheet> a skos:Concept ;
    rdfs:label "author sheet"@en ;
    dcterms:creator "ESRA platform" ;
