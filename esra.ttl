<https://data.energystoragera.org/ns#origin/ai_extracted_unreviewed> a skos:Concept ;
    rdfs:label "ai extracted unreviewed"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-10-29"^^xsd:date ;
