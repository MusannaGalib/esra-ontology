    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/semantic.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "The index of a study graph. Read first."@en ;
    skos:notation "DataCard" .

esra:Person a owl:Class ;
    rdfs:label "Person"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    rdfs:subClassOf schema:Person ;
    skos:definition "A researcher who made or measured cells."@en .

<https://data.energystoragera.org/ns#origin/read_from_file> a skos:Concept ;
    rdfs:label "read from file"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/semantic.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "Read or computed by a reader from a deposited instrument file. A header or settings value, or a span, count or range over its data columns."@en ;
    skos:inScheme esra:OriginValues ;
    skos:notation "read_from_file" ;
    skos:scopeNote "Evidence class deposit_evidence: Read or taken from what the authors deposited."@en .

esra:LinkStatusValues a skos:ConceptScheme ;
    rdfs:label "Link status values"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-15"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/annotations.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "Whether a row of an author's spreadsheet was linked to a data file."@en .

esra:Paper a owl:Class ;
    rdfs:label "Paper"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    rdfs:subClassOf schema:ScholarlyArticle ;
    skos:definition "A publication the study cites."@en .

esra:UnitBasisValues a skos:ConceptScheme ;
    rdfs:label "Unit basis values"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-15"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/annotations.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "How the unit of a value read from a file was known. Each value of esra:unitBasis is one of these."@en .

esra:InterlaboratoryStudy a owl:Class ;
    rdfs:label "Interlaboratory study"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    rdfs:subClassOf esra:Study ;
    skos:definition "A study in which several groups measure the same materials (the scanner's study node type)."@en ;
    skos:notation "InterlaboratoryStudy" .

esra:SharedIdentifier a owl:Class ;
    rdfs:label "Shared identifier"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:source "Data_pipeline/ontology/vocabulary/graph_terms.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "An identifier text that also occurs in another study, listed as a candidate only, not confirmed to name the same object."@en ;
    skos:notation "SharedIdentifier" .

esra:StatusValues a skos:ConceptScheme ;
    rdfs:label "Status values"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-15"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/annotations.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "Why a field has no value, or only part of one, in the kept values. Each value of esra:status is one of these."@en .

esra:CrossStudyLink a owl:Class ;
    rdfs:label "Cross study link"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:source "Data_pipeline/ontology/vocabulary/graph_terms.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "A link from a study's own node to the canonical node that several studies share, with the basis of the join."@en ;
    skos:notation "CrossStudyLink" .

esra:Instrument a owl:Class ;
    rdfs:label "Instrument"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    rdfs:subClassOf chameo:CharacterisationMeasurementInstrument ;
    skos:definition "One distinct (vendor, model, serial) a reader reported."@en .

esra:Record a owl:Class ;
    rdfs:label "Record"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:source "Data_pipeline/ontology/vocabulary/graph_terms.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "A fact of the scan that is not a field value, carried with its kind, accounting category, origin and the scan entry it came from."@en .

esra:Study a owl:Class ;
    rdfs:label "Study"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    rdfs:subClassOf schema:Dataset ;
    skos:definition "One deposited study folder and everything the scan found in it."@en .

esra:Locator a owl:Class ;
    rdfs:label "Locator"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/semantic.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "The place a value was read from. File, sheet, row, column or key."@en .

esra:Metric a owl:Class ;
    rdfs:label "Metric"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/semantic.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "A named computation (a derivation) with its inputs and outputs. Never a result."@en .

esra:TableRow a owl:Class ;
    rdfs:label "Table row"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/semantic.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "One row of an author spreadsheet, as the scan kept it."@en ;
    skos:notation "TableRow" .

esra:Alert a owl:Class ;
    rdfs:label "Alert"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "A rule's finding about the graph, open until an action closes it."@en ;
    skos:editorialNote "No alert or finding class exists in the bundled ontology or schema.org."@en .

esra:Batch a owl:Class ;
    rdfs:label "Batch"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "One synthesis or purchase lot that samples were made from."@en ;
    skos:editorialNote "No batch or lot class exists in the bundled battery-inferred.ttl or in schema.org; published without an equivalent."@en .

esra:LocatorLevelValues a skos:ConceptScheme ;
    rdfs:label "Locator level values"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-15"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/annotations.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "How precisely the place a value was read from is known. Each value of esra:locatorLevel is one of these."@en .

esra:Action a owl:Class ;
    rdfs:label "Action"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:altLabel "ActionRecord"@en ;
    skos:definition "One recorded change a person or an agent made to the graph, undoable."@en ;
    skos:editorialNote "schema:Action names the act, not the appended record of it; decided in the actions phase."@en .

esra:NotInKeptValues a owl:Class ;
    rdfs:label "Not in kept values"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/semantic.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "A field of a technique's schema that the kept values do not fully record."@en ;
    skos:notation "NotInKeptValues" .

esra:Question a owl:Class ;
    rdfs:label "Question"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "Something the scan could not decide and asks a person, with numbered options and a default."@en ;
    skos:editorialNote "The scanner's open question has no counterpart class in the bundled ontology or schema.org."@en .

esra:Column a owl:Class ;
    rdfs:label "Column"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/semantic.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "One column of a Table, with the header as written, the unit the header states, how many cells hold a value, and its first values."@en .

esra:DerivedValue a owl:Class ;
    rdfs:label "Derived value"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    rdfs:subClassOf schema:PropertyValue ;
    skos:definition "A value computed from the study's files, with its workflow and provenance."@en ;
    skos:editorialNote "A value ESRA's tools computed; a kind of PropertyValue, not equivalent to one."@en ;
    skos:notation "DerivedValue" .

esra:Value a owl:Class ;
    rdfs:label "Value"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/semantic.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "One value of the v1.1 scan with its origin and the place it was read from."@en .

esra:OriginValues a skos:ConceptScheme ;
    rdfs:label "Origin values"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-15"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/annotations.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "Where a recorded value came from. Each value of esra:origin is one of these."@en .

esra:Table a owl:Class ;
    rdfs:label "Table"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-10-29"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/semantic.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    skos:definition "One tab of a spreadsheet the authors deposited, or one data table of an instrument file. Its CSV copy has the sheet's own row and column numbers; a table of an instrument file is a reference without rows."@en .

esra:Sample a owl:Class ;
    rdfs:label "Sample"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    rdfs:subClassOf chameo:Sample ;
    skos:definition "A specimen with its own identity - a synthesis product with an ESRA sample ID, or a pellet shared by cells across stages; linked only on a confirmed answer, never guessed."@en .

esra:File a owl:Class ;
    rdfs:label "File"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    rdfs:subClassOf schema:MediaObject,
        emmo:EMMO_998dd3a0_c85f_4c8d_9fb8_816a93cc3bb8 ;
    skos:definition "One data or metadata file of the study."@en .

esra:Material a owl:Class ;
    rdfs:label "Material"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    rdfs:subClassOf emmo:EMMO_4207e895_8b83_4318_996a_72cfb32acd94 ;
    skos:definition "A material as the study names it; a variant points at its canonical material with variantOf or sameAs. A declared material's crate node is also a schema.org ChemicalSubstance (a pending schema.org type, so not stated as an equivalent class)."@en .

esra:Cell a owl:Class ;
    rdfs:label "Cell"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-13"^^xsd:date ;
    dcterms:source "Data_pipeline/ontology/vocabulary/ontology.yaml" ;
    rdfs:isDefinedBy <https://data.energystoragera.org/ns> ;
    rdfs:subClassOf echem:electrochemistry_6f2c88c9_5c04_4953_a298_032cc3ab9b77 ;
    skos:definition "One measured unit as the scanner groups it (a trial); the stage segment is absent when a researcher has one stage."@en .

<https://data.energystoragera.org/ns> a owl:Ontology ;
    rdfs:label "ESRA ontology"@en ;
    dcterms:creator "ESRA platform" ;
    dcterms:date "2026-11-15"^^xsd:date ;
    dcterms:description "The terms the Energy Storage Research Alliance data platform adds on top of EMMO and BattINFO: how a deposited battery study is put together (study, cell, sample, batch, file, instrument) and where every recorded value came from (read from a file, stated by the author, computed, answered by a person, or extracted by an AI and not yet reviewed). Measured quantities themselves are named with EMMO, BattINFO, CHAMEO and QUDT terms; an ESRA term exists only where those have none."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:publisher "Energy Storage Research Alliance, Argonne National Laboratory" ;
    dcterms:source "Data_pipeline/ontology/vocabulary/annotations.yaml",
        "Data_pipeline/ontology/vocabulary/derived.yaml",
        "Data_pipeline/ontology/vocabulary/graph_terms.yaml",
        "Data_pipeline/ontology/vocabulary/ontology.yaml",
        "Data_pipeline/ontology/vocabulary/semantic.yaml" ;
    dcterms:title "ESRA ontology"@en ;
    vann:preferredNamespacePrefix "esra" ;
    vann:preferredNamespaceUri "https://data.energystoragera.org/ns#"^^xsd:anyURI ;
    rdfs:comment "The terms of the ESRA namespace: the classes, properties and links of the working graph, the vocabulary of the semantic layer and the terms a person approved. Generated by Data_pipeline/ontology/build_esra_ttl.py."@en ;
    rdfs:seeAlso <https://github.com/MusannaGalib/esra-ontology>,
        <https://w3id.org/emmo>,
        <https://w3id.org/emmo/domain/battery> ;
    owl:versionIRI <https://data.energystoragera.org/ns/2026-11-15> ;
    owl:versionInfo "2026-11-15" .
